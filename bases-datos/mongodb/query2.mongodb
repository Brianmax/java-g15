use('mongdb1');
db.universidad.insertOne(
    {
    nombre: 1,
    ubicacion: 'Tacna',
    facultades: ['Ingeniería de Minas', 'Contabilidad', 'Derecho'],
    alumnos: 4300,
    direccion: {
      calle: 'Av. Miraflores',
      numero: 350,
      ciudad: 'Tacna',
      pais: 'Perú'
    },
    presupuesto: 2300000
  }
)

// operador and
// traer a todas las universidades que tengan más de 5000 alumnos y un presupuesto mayor a 3000000
use('mongdb1');
db.universidad.find(
    {
        alumnos: { $gt: 5000 },
        presupuesto: { $gt: 3000000 }
    }
)

use('mongdb1');
db.universidad.find(
    {
        $and: [
            { alumnos: { $gt: 5000 } },
            { presupuesto: { $gt: 3000000 } }
        ]
    }
)

// operador or
// traer a todas las universidades que tengan más de 5000 alumnos o un presupuesto mayor a 3000000
use('mongdb1');
db.universidad.find(
    {
        $or: [
            { alumnos: { $gt: 5000 } },
            { presupuesto: { $gt: 3000000 } }
        ]
    }
)

// and y or juntos
// traer todos los documentos donde el numero de alumnos sea menor que 10k
// o el presupuesto supere o sea igual a 4M, pero ademas la universidad debe estar ubicada en Lima

use('mongdb1');
db.universidad.find(
    {
        "direccion.ciudad": "Lima",
    }
);
